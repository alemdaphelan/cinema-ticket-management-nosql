APP_NAME=CinemaTicketManagement
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cinema_ticket_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=cinema:v1:cache:

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=cinema:v1:
REDIS_DB=0
REDIS_CACHE_DB=1
NOSQL_REDIS_CONNECTION=default
NOSQL_REDIS_CACHE_STORE=redis
NOSQL_REDIS_SEAT_HOLD_STORE=redis
NOSQL_REDIS_LEADERBOARD_STORE=redis
NOSQL_REDIS_MOVIE_TTL_SECONDS=600
NOSQL_REDIS_SHOW_TTL_SECONDS=300
NOSQL_REDIS_SEAT_HOLD_TTL_SECONDS=600
NOSQL_REDIS_LEADERBOARD_TTL_SECONDS=2678400
NOSQL_REDIS_LEADERBOARD_VIEW_WEIGHT=1
NOSQL_REDIS_LEADERBOARD_REVIEW_WEIGHT=3
NOSQL_REDIS_LEADERBOARD_BOOKING_WEIGHT=5

MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_HOST_PORT=27018
MONGO_DATABASE=cinema_content
MONGO_ROOT_USERNAME=cinema_admin
MONGO_ROOT_PASSWORD=replace_with_a_strong_mongo_admin_password
MONGO_APP_USERNAME=cinema_app
MONGO_APP_PASSWORD=replace_with_a_strong_mongo_app_password
MONGO_USERNAME=cinema_app
MONGO_PASSWORD=replace_with_a_strong_mongo_app_password
MONGO_AUTH_DATABASE=cinema_content
MONGODB_URI=mongodb://cinema_app:replace_with_a_strong_mongo_app_password@127.0.0.1:27018/cinema_content?authSource=cinema_content
NOSQL_MONGODB_DRIVER=mongodb
NOSQL_MONGODB_CONNECTION=mongodb
MONGO_REVIEW_COLLECTION=movie_reviews
MONGO_CHAT_COLLECTION=chat_sessions
MONGO_OUTBOX_COLLECTION=integration_outbox
MONGO_OUTBOX_BATCH_SIZE=100
MONGO_CHAT_TTL_HOURS=24
MONGO_CONNECT_TIMEOUT_MS=3000

CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=cinema_analytics
CASSANDRA_ADMIN_PASSWORD=replace_with_a_strong_cassandra_admin_password
CASSANDRA_APP_USERNAME=cinema_app
CASSANDRA_APP_PASSWORD=replace_with_a_strong_cassandra_app_password
CASSANDRA_USERNAME=cinema_app
CASSANDRA_PASSWORD=replace_with_a_strong_cassandra_app_password
NOSQL_CASSANDRA_DRIVER=http
CASSANDRA_API_URL=http://127.0.0.1:9043
CASSANDRA_DC=datacenter1
CASSANDRA_CONSISTENCY=LOCAL_QUORUM
CASSANDRA_CONNECT_TIMEOUT_SECONDS=5
CASSANDRA_REQUEST_TIMEOUT_SECONDS=10
CASSANDRA_ACTIVITY_TTL_SECONDS=7776000
CASSANDRA_AUDIT_TTL_SECONDS=15552000

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_URL=http://127.0.0.1:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_a_strong_neo4j_password
NOSQL_NEO4J_DRIVER=http
NEO4J_CONNECT_TIMEOUT_SECONDS=5
NEO4J_REQUEST_TIMEOUT_SECONDS=15
NEO4J_RECOMMENDATION_CACHE_TTL_SECONDS=300

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
TMDB_API_KEY=
